[
    {
        "id": "eval_01",
        "name": "JWT Authentication Service",
        "description": "A web application uses an Auth Service to authenticate users. The service issues JWT access tokens after login. Clients send the JWT in the Authorization header when calling protected APIs. User credentials are stored in PostgreSQL.",
        "components": [
            {
                "name": "Auth Service",
                "technology": "JWT"
            },
            {
                "name": "User Database",
                "technology": "PostgreSQL"
            }
        ],
        "data_flows": [
            {
                "source": "Client",
                "destination": "Auth Service",
                "description": "User submits credentials and receives a JWT access token"
            },
            {
                "source": "Auth Service",
                "destination": "User Database",
                "description": "Authentication service reads user credentials"
            },
            {
                "source": "Client",
                "destination": "Protected API",
                "description": "Client sends JWT access token in Authorization header"
            }
        ],
        "trust_boundaries": [
            "Client to backend",
            "Backend to database"
        ],
        "expected_threats": [
            {
                "stride": "Spoofing",
                "keywords": [
                    "credential theft",
                    "credential stuffing",
                    "account impersonation"
                ]
            },
            {
                "stride": "Elevation of Privilege",
                "keywords": [
                    "JWT manipulation",
                    "token manipulation",
                    "privilege escalation"
                ]
            },
            {
                "stride": "Information Disclosure",
                "keywords": [
                    "token theft",
                    "access token exposure"
                ]
            }
        ]
    },
